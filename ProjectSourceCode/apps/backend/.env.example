PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Required: session store + cookie signing
DATABASE_URL=postgres://diplomacy:diplomacy@localhost:5432/diplomacy
SESSION_SECRET=change-me-locally-use-a-long-random-string

# Required: comma-separated list of frontend origins allowed via CORS + Socket.IO
FRONTEND_ORIGINS=http://localhost:5173

# Optional: Socket.IO Redis adapter for cross-replica broadcast.
# When unset, uses the in-memory adapter
REDIS_URL=

# Optional: cookie domain for cross-subdomain session sharing.
# Leave unset for local dev (host-only cookie on localhost).
# Set to .diplomacy.gg in cloud environments (dev/stage/prod).
# COOKIE_DOMAIN=.diplomacy.gg

# Optional: Resend API key for sending transactional emails (verify, reset, etc).
# When unset, emails are logged to the console instead of delivered.
# RESEND_API_KEY=re_xxx

# Email "from" address for transactional emails.
# Use `onboarding@resend.dev` for testing (limited to your Resend account's
# verified addresses). Switch to the real sender once the `diplomacy.gg`
# subdomain is verified at Resend.
EMAIL_FROM=no-reply@diplomacy.gg

# Base URL of the frontend app; used to build email links (verify, reset).
APP_URL=http://localhost:5173

# Optional: OAuth sign-in. A provider is enabled when both its client ID and
# secret are set. Register this redirect URI with each provider:
#   <API_PUBLIC_URL>/auth/oauth/<google|microsoft>/callback
# Local dev goes through the Vite proxy, so locally that's
#   http://localhost:5173/api/auth/oauth/google/callback
# Required when any provider is enabled; docker compose already sets the local
# value. Cloud: https://api.<env>.diplomacy.gg
# API_PUBLIC_URL=http://localhost:5173/api

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft Entra admin center > App registrations. Supported account types:
# "any organizational directory and personal Microsoft accounts". Under Token
# configuration, add the `email` and `xms_edov` optional claims to the ID token;
# without `xms_edov`, every Microsoft sign-in is rejected as unverified email.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
