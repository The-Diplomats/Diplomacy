LOG_LEVEL=info
NODE_ENV=development

# Required: BullMQ connection + Socket.IO redis-emitter use the same Redis instance.
REDIS_URL=redis://localhost:6379

# AI turns: fixtures by default. For a real model set MOCK_AI=false, a key (free at console.groq.com)
# and a daily token ceiling. See README for LLM_BASE_URL / LLM_MODEL.
MOCK_AI=true
# LLM_API_KEY=
# LLM_DAILY_TOKEN_BUDGET=
