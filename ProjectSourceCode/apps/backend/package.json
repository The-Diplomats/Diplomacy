{
  "name": "@diplomacy/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Diplomacy HTTP API Express server",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts | pnpm exec pino-pretty",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@diplomacy/contracts": "workspace:^",
    "express": "catalog:",
    "helmet": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
