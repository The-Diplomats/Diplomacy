# Base URL for backend HTTP calls. Dev uses the /api proxy prefix defined in vite.config.ts;
# cloud deploys set this to the environment's api subdomain (e.g. https://api.dev.diplomacy.gg).
VITE_API_URL=/api

# WebSocket URL. Dev uses relative path (Vite proxies /socket.io/*); cloud uses wss://api.*.
VITE_WS_URL=/
