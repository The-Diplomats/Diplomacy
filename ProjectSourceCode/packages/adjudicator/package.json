{
  "name": "@diplomacy/adjudicator",
  "version": "0.0.0",
  "private": true,
  "description": "Pure-function Diplomacy adjudicator",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@diplomacy/game-types": "workspace:^"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
