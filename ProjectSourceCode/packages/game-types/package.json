{
  "name": "@diplomacy/game-types",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript domain types for Diplomacy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc -b --noEmit",
    "clean": "rm -rf dist",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "catalog:"
  }
}
