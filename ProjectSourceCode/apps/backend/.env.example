PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Required: session store + cookie signing
DATABASE_URL=postgres://localhost:5432/diplomacy_dev
SESSION_SECRET=change-me-locally-use-a-long-random-string

# Required: comma-separated list of frontend origins allowed via CORS + Socket.IO
FRONTEND_ORIGINS=http://localhost:5173

# Optional: Socket.IO Redis adapter for cross-replica broadcast.
# When unset, uses the in-memory adapter
REDIS_URL=

# Optional: cookie domain for cross-subdomain session sharing.
# Leave unset for local dev (host-only cookie on localhost).
# Set to .diplomacy.gg in cloud environments (dev/stage/prod).
# COOKIE_DOMAIN=.diplomacy.gg

# Optional: Resend API key for sending transactional emails (verify, reset, etc).
# When unset, emails are logged to the console instead of delivered.
# RESEND_API_KEY=re_xxx

# Email "from" address for transactional emails.
# Use `onboarding@resend.dev` for testing (limited to your Resend account's
# verified addresses). Switch to the real sender once the `email.diplomacy.gg`
# subdomain is verified at Resend.
EMAIL_FROM=no-reply@email.diplomacy.gg

# Base URL of the frontend app; used to build email links (verify, reset).
APP_URL=http://localhost:5173
